@model declaracionPatrimonial.Models.Bienes

@{
    ViewData["Title"] = "Registrar Bien";
}

<div class="container py-5">
    <!-- ENCABEZADO -->
    <div class="bg-white/80 backdrop-blur-md shadow-lg rounded-4 border border-gray-100 p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bold mb-1 text-gradient"
                    style="background: linear-gradient(90deg, #6a11cb, #2575fc); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                    Registrar Nuevo Bien
                </h2>
                <p class="text-muted mb-0">Completa los campos para agregar un bien patrimonial.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-primary rounded-pill fw-semibold shadow-sm">
                <i class="bi bi-arrow-left me-1"></i> Volver
            </a>
        </div>
    </div>

    <!-- FORMULARIO -->
    <div class="bg-white p-5 shadow-lg rounded-4 border-0">
        <form asp-action="Create" method="post" novalidate autocomplete="off" id="formBien" class="needs-validation">
            @Html.AntiForgeryToken()

            <div class="row g-4">
                <!-- Nombre del bien -->
                <div class="col-md-6">
                    <label asp-for="Nombre_Bienes" class="form-label fw-semibold">Nombre del bien</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0">
                            <i class="bi bi-box-seam text-primary"></i>
                        </span>
                        <input asp-for="Nombre_Bienes"
                               class="form-control border-0 shadow-sm rounded-end focus-ring"
                               placeholder="Ej. Casa, vehículo, terreno"
                               maxlength="100" />
                    </div>
                    <span asp-validation-for="Nombre_Bienes" class="invalid-feedback d-block small"></span>
                </div>

                <!-- Fecha de adquisición -->
                <div class="col-md-6">
                    <label asp-for="Fecha_adquisicionBien" class="form-label fw-semibold">Fecha de adquisición</label>
                    <input asp-for="Fecha_adquisicionBien"
                           type="date"
                           class="form-control border-0 shadow-sm rounded-3 focus-ring" />
                    <span asp-validation-for="Fecha_adquisicionBien" class="invalid-feedback d-block small"></span>
                </div>

                <!-- Descripción -->
                <div class="col-12">
                    <label asp-for="Descripcion_Bien" class="form-label fw-semibold">Descripción del bien</label>
                    <textarea asp-for="Descripcion_Bien"
                              class="form-control border-0 shadow-sm rounded-3 focus-ring"
                              rows="3"
                              placeholder="Describe brevemente las características del bien..."></textarea>
                    <span asp-validation-for="Descripcion_Bien" class="invalid-feedback d-block small"></span>
                </div>

                <!-- Forma de adquisición -->
                <div class="col-md-6">
                    <label asp-for="Forma_adquisicionBien" class="form-label fw-semibold">Forma de adquisición</label>
                    <input asp-for="Forma_adquisicionBien"
                           class="form-control border-0 shadow-sm rounded-3 focus-ring"
                           placeholder="Ej. Compra, donación, herencia"
                           maxlength="100" />
                    <span asp-validation-for="Forma_adquisicionBien" class="invalid-feedback d-block small"></span>
                </div>

                <!-- Precio -->
                <div class="col-md-6">
                    <label asp-for="Precio_Bien" class="form-label fw-semibold">Precio (Q)</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0">Q</span>
                        <input asp-for="Precio_Bien"
                               type="number" step="0.01" min="0"
                               class="form-control border-0 shadow-sm rounded-end focus-ring"
                               placeholder="Ej. 250000.00" />
                    </div>
                    <span asp-validation-for="Precio_Bien" class="invalid-feedback d-block small"></span>
                </div>

                <!-- Tipo de Inmueble -->
                <div class="col-md-6">
                    <label asp-for="IDtipoInmueble" class="form-label fw-semibold">Tipo de inmueble</label>
                    <select asp-for="IDtipoInmueble"
                            class="form-select border-0 shadow-sm rounded-3 focus-ring"
                            asp-items="@(new SelectList(ViewBag.TiposInmueble, "IDtipoInmueble", "Nombre_tipoInmueble"))">
                        <option value="">Seleccione un tipo de inmueble</option>
                    </select>
                    <span asp-validation-for="IDtipoInmueble" class="invalid-feedback d-block small"></span>
                </div>

                <!-- Tipo de Propiedad -->
                <div class="col-md-6">
                    <label asp-for="IDtipoPropiedad" class="form-label fw-semibold">Tipo de propiedad</label>
                    <select asp-for="IDtipoPropiedad"
                            class="form-select border-0 shadow-sm rounded-3 focus-ring"
                            asp-items="@(new SelectList(ViewBag.TiposPropiedad, "IDtipoPropiedad", "Nombre_tipoPropiedad"))">
                        <option value="">Seleccione un tipo de propiedad</option>
                    </select>
                    <span asp-validation-for="IDtipoPropiedad" class="invalid-feedback d-block small"></span>
                </div>
            </div>

            <!-- Botones -->
            <div class="text-center mt-5">
                <button type="submit"
                        class="btn btn-gradient px-5 py-2 rounded-pill text-white shadow-sm fw-semibold ripple"
                        style="background: linear-gradient(90deg, #6a11cb, #2575fc);">
                    <i class="bi bi-check-circle me-2"></i>Guardar Bien
                </button>
                <button type="button"
                        id="btnCancelar"
                        class="btn btn-outline-secondary px-5 py-2 rounded-pill ms-2 shadow-sm ripple">
                    <i class="bi bi-x-circle me-2"></i>Cancelar
                </button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL CONFIRMACIÓN -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 text-white"
                 style="background: linear-gradient(90deg, #6a11cb, #2575fc);">
                <h5 class="modal-title fw-semibold"><i class="bi bi-check2-circle me-2"></i>Confirmación</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center py-4">
                <p class="mb-3 fs-5"> La cuenta bancaria se ha registrado exitosamente.</p>
                <button class="btn btn-gradient text-white px-4 rounded-pill" data-bs-dismiss="modal"
                        style="background: linear-gradient(90deg, #6a11cb, #2575fc);">
                    Aceptar
                </button>
            </div>
        </div>
    </div>
</div>
<!-- Modal de cancelación -->
<div class="modal fade" id="cancelModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 text-white"
                 style="background: #6c757d;">
                <h5 class="modal-title fw-semibold"><i class="bi bi-exclamation-triangle me-2"></i>Cancelar Registro</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center py-4">
                <p class="mb-3 fs-5">¿Está seguro que desea cancelar el registro del crédito?</p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">Sí, cancelar</a>
                    <button class="btn btn-gradient text-white px-4 rounded-pill" data-bs-dismiss="modal"
                            style="background: linear-gradient(90deg, #6a11cb, #2575fc);">No</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/validacionBienes.js"></script>
}
