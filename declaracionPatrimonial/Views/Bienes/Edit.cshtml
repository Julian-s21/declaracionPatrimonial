@model declaracionPatrimonial.Models.Bienes

@{
    ViewData["Title"] = "Editar Bien";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="card border-0 shadow-xl rounded-4 overflow-hidden">
        <!-- ENCABEZADO -->
        <div class="card-header text-white py-4 px-4"
             style="background: linear-gradient(90deg, #6a11cb, #2575fc);">
            <div class="d-flex justify-content-between align-items-center">
                <h3 class="mb-0 fw-semibold d-flex align-items-center">
                    <i class="bi bi-house-door me-2 fs-4"></i>
                    Editar Bien
                </h3>
                <a asp-action="Index" class="btn btn-light btn-sm fw-semibold shadow-sm px-3">
                    <i class="bi bi-arrow-left me-1"></i> Volver
                </a>
            </div>
        </div>

        <!-- FORMULARIO -->
        <div class="card-body bg-light p-4">
            <form asp-action="Edit" method="post" id="formBien" novalidate>
                <input type="hidden" asp-for="IDBienes" />
                <input type="hidden" asp-for="IDUsuario" />

                <div class="row g-4">
                    <!-- Nombre del Bien -->
                    <div class="col-md-6">
                        <label asp-for="Nombre_Bienes" class="form-label fw-semibold">Nombre del Bien</label>
                        <input asp-for="Nombre_Bienes" class="form-control rounded-3 shadow-sm" 
                               placeholder="Ej. Casa, vehículo, terreno..." />
                        <span asp-validation-for="Nombre_Bienes" class="text-danger small"></span>
                    </div>

                    <!-- Fecha de adquisición -->
                    <div class="col-md-6">
                        <label asp-for="Fecha_adquisicionBien" class="form-label fw-semibold">Fecha de Adquisición</label>
                        <input asp-for="Fecha_adquisicionBien" class="form-control rounded-3 shadow-sm" 
                               type="date" />
                        <span asp-validation-for="Fecha_adquisicionBien" class="text-danger small"></span>
                    </div>

                    <!-- Descripción -->
                    <div class="col-12">
                        <label asp-for="Descripcion_Bien" class="form-label fw-semibold">Descripción</label>
                        <textarea asp-for="Descripcion_Bien" class="form-control rounded-3 shadow-sm" 
                                  rows="3" placeholder="Ej. Casa de dos niveles ubicada en..."></textarea>
                        <span asp-validation-for="Descripcion_Bien" class="text-danger small"></span>
                    </div>

                    <!-- Forma de adquisición -->
                    <div class="col-md-6">
                        <label asp-for="Forma_adquisicionBien" class="form-label fw-semibold">Forma de Adquisición</label>
                        <input asp-for="Forma_adquisicionBien" class="form-control rounded-3 shadow-sm"
                               placeholder="Ej. Compra, herencia, donación..." />
                        <span asp-validation-for="Forma_adquisicionBien" class="text-danger small"></span>
                    </div>

                    <!-- Precio -->
                    <div class="col-md-6">
                        <label asp-for="Precio_Bien" class="form-label fw-semibold">Precio (Q)</label>
                        <input asp-for="Precio_Bien" class="form-control rounded-3 shadow-sm" 
                               type="number" step="0.01" min="0" placeholder="Ej. 50000.00" />
                        <span asp-validation-for="Precio_Bien" class="text-danger small"></span>
                    </div>

                    <!-- Tipo de Inmueble -->
                    <div class="col-md-6">
                        <label asp-for="IDtipoInmueble" class="form-label fw-semibold">Tipo de Inmueble</label>
                        <select asp-for="IDtipoInmueble" class="form-select rounded-3 shadow-sm"
                                asp-items="@(new SelectList(ViewBag.TiposInmueble, "IDtipoInmueble", "Nombre_tipoInmueble", Model.IDtipoInmueble))">
                            <option value="">Seleccione tipo de inmueble</option>
                        </select>
                        <span asp-validation-for="IDtipoInmueble" class="text-danger small"></span>
                    </div>

                    <!-- Tipo de Propiedad -->
                    <div class="col-md-6">
                        <label asp-for="IDtipoPropiedad" class="form-label fw-semibold">Tipo de Propiedad</label>
                        <select asp-for="IDtipoPropiedad" class="form-select rounded-3 shadow-sm"
                                asp-items="@(new SelectList(ViewBag.TiposPropiedad, "IDtipoPropiedad", "Nombre_tipoPropiedad", Model.IDtipoPropiedad))">
                            <option value="">Seleccione tipo de propiedad</option>
                        </select>
                        <span asp-validation-for="IDtipoPropiedad" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Botones -->
                <div class="text-center mt-5">
                    <button type="submit" class="btn px-5 py-2 rounded-pill text-white shadow-sm fw-semibold ripple"
                            style="background: linear-gradient(90deg, #6a11cb, #2575fc); transition: all 0.3s;">
                        <i class="bi bi-save me-2"></i>Guardar Cambios
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-5 py-2 rounded-pill ms-2 fw-semibold">
                        <i class="bi bi-x-circle me-1"></i>Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/validacionBienes.js"></script>
}
