@model List<declaracionPatrimonial.Models.Bienes>

@{
    ViewData["Title"] = "Bienes";
    Layout = "~/Views/Shared/_Layout.cshtml";

    decimal totalValor = Model?.Sum(b => b.Precio_Bien ?? 0) ?? 0;
    int totalBienes = Model?.Count ?? 0;
    var usuario = Model?.FirstOrDefault()?.Usuario;
}

<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600&display=swap" rel="stylesheet" />

<!-- Intro.js -->
<link href="https://unpkg.com/intro.js/minified/introjs.min.css" rel="stylesheet" />

<div class="container py-5" style="font-family: 'Inter', sans-serif;">

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb bg-white p-3 rounded shadow-sm">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-primary fw-semibold">
                    <i class="bi bi-house-door me-1"></i> Inicio
                </a>
            </li>
            <li class="breadcrumb-item active fw-semibold text-dark" aria-current="page">Bienes</li>
        </ol>
    </nav>

    <!-- Bienvenida -->
    <div class="alert alert-light border-start border-4 border-primary shadow-sm rounded-4 mb-4 d-flex justify-content-between align-items-center flex-wrap">
        <div class="d-flex align-items-center">
            <i class="bi bi-person-circle text-primary fs-3 me-3"></i>
            <div>
                <h5 class="mb-0 fw-semibold" style="font-family:'Poppins', sans-serif;">
                    Bienvenido, @usuario?.Nombre_Usuario @usuario?.Apellido_Usuario
                </h5>
                <small class="text-muted">Administra tus bienes registrados fácilmente.</small>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <button id="btnTour" class="btn btn-outline-primary btn-sm" data-bs-toggle="tooltip" title="Ver guía interactiva">
                <i class="bi bi-info-circle me-1"></i> Guía
            </button>
            <a asp-controller="Usuario" asp-action="Logout" class="btn btn-light btn-sm" title="Cerrar sesión">
                <i class="bi bi-box-arrow-right me-1"></i> Salir
            </a>
        </div>
    </div>

    <!-- Panel principal -->
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

        <!-- Header -->
        <div class="card-header text-white py-4 px-4 d-flex justify-content-between align-items-center flex-wrap header-gradient" 
             style="background: linear-gradient(90deg, #6a11cb, #2575fc);">
            <h3 class="mb-0 fw-semibold d-flex align-items-center">
                <i class="bi bi-house-door-fill me-2 fs-4"></i> Gestión de Bienes
            </h3>

            <a asp-controller="Bienes" asp-action="Create"
               class="btn btn-light btn-sm fw-semibold shadow-sm px-3 mt-2 mt-md-0"
               id="btnNuevoBien" title="Registrar un nuevo bien" role="button">
                <i class="bi bi-plus-circle me-1"></i> Nuevo Bien
            </a>
        </div>

        <!-- Body -->
        <div class="card-body p-4 bg-light">

            <!-- Filtros -->
            <div class="row mb-4 g-3 align-items-end" id="busquedaBienes">
                <!-- Búsqueda general -->
                <div class="col-lg-4 col-md-6">
                    <label for="searchInput" class="form-label fw-semibold text-secondary">Buscar bien</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" id="searchInput"
                               class="form-control border-start-0 shadow-sm"
                               placeholder="Buscar por nombre o descripción..." />
                    </div>
                </div>

                <!-- Filtro tipo de inmueble -->
                <div class="col-lg-4 col-md-3">
                    <label for="filtroInmueble" class="form-label fw-semibold text-secondary">Filtrar por tipo de inmueble</label>
                    <select id="filtroInmueble" class="form-select shadow-sm">
                        <option value="">Todos</option>
                        @foreach (var tipo in (Model ?? Enumerable.Empty<declaracionPatrimonial.Models.Bienes>())
                            .Select(m => m.tipoInmueble?.Nombre_tipoInmueble)
                            .Where(t => !string.IsNullOrEmpty(t))
                            .Distinct())
                        {
                            <option value="@tipo">@tipo</option>
                        }
                    </select>
                </div>

                <!-- Filtro tipo de propiedad -->
                <div class="col-lg-4 col-md-3">
                    <label for="filtroPropiedad" class="form-label fw-semibold text-secondary">Filtrar por tipo de propiedad</label>
                    <select id="filtroPropiedad" class="form-select shadow-sm">
                        <option value="">Todos</option>
                        @foreach (var tipo in (Model ?? Enumerable.Empty<declaracionPatrimonial.Models.Bienes>())
                            .Select(m => m.tipoPropiedad?.Nombre_tipoPropiedad)
                            .Where(t => !string.IsNullOrEmpty(t))
                            .Distinct())
                        {
                            <option value="@tipo">@tipo</option>
                        }
                    </select>
                </div>
            </div>

            <!-- Totales -->
            <div class="row justify-content-center mb-4">
                <div class="col-md-5 mb-3 mb-md-0">
                    <div class="bg-white p-3 rounded shadow-sm border-start border-4 border-primary text-center">
                        <span class="fw-semibold text-muted me-2">
                            <i class="bi bi-box-seam me-1"></i> Total bienes:
                        </span>
                        <span class="fw-bold">@totalBienes</span>
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="bg-white p-3 rounded shadow-sm border-start border-4 border-success text-center">
                        <span class="fw-semibold text-muted me-2">
                            <i class="bi bi-cash-stack me-1"></i> Valor total:
                        </span>
                        <span class="fw-bold text-success">Q @totalValor.ToString("N2")</span>
                    </div>
                </div>
            </div>

            <!-- Tabla -->
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive" id="tablaBienes">
                    <table class="table table-hover align-middle bg-white rounded-4 shadow-sm">
                        <thead class="text-white text-center" style="background: linear-gradient(90deg, #6a11cb, #2575fc);">
                            <tr>
                                <th scope="col">Nombre del Bien</th>
                                <th scope="col">Descripción</th>
                                <th scope="col">Tipo Inmueble</th>
                                <th scope="col">Tipo Propiedad</th>
                                <th scope="col">Forma de Adquisición</th>
                                <th scope="col">Fecha de Adquisición</th>
                                <th scope="col">Precio (Q)</th>
                                <th scope="col" class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var bien in Model)
                            {
                                <tr class="hover:bg-indigo-50 transition-all duration-200">
                                    <td>@bien.Nombre_Bienes</td>
                                    <td>@bien.Descripcion_Bien</td>
                                    <td>@bien.tipoInmueble?.Nombre_tipoInmueble</td>
                                    <td>@bien.tipoPropiedad?.Nombre_tipoPropiedad</td>
                                    <td>@bien.Forma_adquisicionBien</td>
                                    <td>@bien.Fecha_adquisicionBien?.ToString("dd/MM/yyyy")</td>
                                    <td class="text-success fw-bold">Q @bien.Precio_Bien?.ToString("N2")</td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-2">
                                            <!-- Editar -->
                                            <form asp-action="LoadEdit" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@bien.IDBienes" />
                                                <button type="submit" class="btn btn-outline-success btn-sm rounded-circle shadow-sm" title="Editar bien">
                                                    <i class="bi bi-pencil-square"></i>
                                                </button>
                                            </form>

                                            <!-- Eliminar -->
                                            <form asp-action="DeleteConfirmed" method="post" class="d-inline" id="formEliminar-@bien.IDBienes">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@bien.IDBienes" />
                                                <button type="button"
                                                        onclick="confirmarEliminacion('formEliminar-@bien.IDBienes')"
                                                        class="btn btn-outline-danger btn-sm rounded-circle shadow-sm"
                                                        title="Eliminar bien">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-info-circle text-primary fs-3"></i>
                    <p class="mt-2 mb-0 text-muted fw-semibold">No hay bienes registrados.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/intro.js/minified/intro.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => new bootstrap.Tooltip(el));

        function confirmarEliminacion(formId) {
            Swal.fire({
                title: "¿Eliminar bien?",
                text: "Esta acción no se puede deshacer.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#2575fc",
                cancelButtonColor: "#d33",
                confirmButtonText: "Sí, eliminar",
                cancelButtonText: "Cancelar"
            }).then((result) => {
                if (result.isConfirmed) document.getElementById(formId).submit();
            });
        }

        // Filtros
        (() => {
            const search = document.getElementById('searchInput');
            const filtroInmueble = document.getElementById('filtroInmueble');
            const filtroPropiedad = document.getElementById('filtroPropiedad');
            const filas = document.querySelectorAll('#tablaBienes tbody tr');

            function aplicarFiltros() {
                const term = search.value.toLowerCase();
                const inmueble = filtroInmueble.value.toLowerCase();
                const propiedad = filtroPropiedad.value.toLowerCase();

                filas.forEach(row => {
                    const texto = row.textContent.toLowerCase();
                    const coincideBusqueda = texto.includes(term);
                    const coincideInmueble = !inmueble || texto.includes(inmueble);
                    const coincidePropiedad = !propiedad || texto.includes(propiedad);
                    row.style.display = (coincideBusqueda && coincideInmueble && coincidePropiedad) ? '' : 'none';
                });
            }

            [search, filtroInmueble, filtroPropiedad].forEach(el => el.addEventListener('input', aplicarFiltros));
        })();

        // Tour interactivo
        (() => {
            const pasos = [
                { element: '#btnNuevoBien', intro: 'Haz clic aquí para registrar un nuevo bien.', position: 'bottom' },
                { element: '#busquedaBienes', intro: 'Usa esta barra para buscar o filtrar bienes.', position: 'right' },
                { element: '#tablaBienes', intro: 'Aquí se muestran todos tus bienes registrados.', position: 'top' }
            ];

            const intro = introJs();
            intro.setOptions({
                steps: pasos,
                showProgress: true,
                exitOnEsc: true,
                nextLabel: 'Siguiente',
                prevLabel: 'Atrás',
                doneLabel: 'Finalizar'
            });

            document.getElementById('btnTour')?.addEventListener('click', () => intro.start());
        })();

        // Mensaje de éxito
        @if (TempData["MensajeExito"] != null)
        {
            <text>
                Swal.fire({
                    icon: 'success',
                    title: 'Operación exitosa',
                    text: '@TempData["MensajeExito"]',
                    timer: 2000,
                    showConfirmButton: false
                });
            </text>
        }
    </script>
}
