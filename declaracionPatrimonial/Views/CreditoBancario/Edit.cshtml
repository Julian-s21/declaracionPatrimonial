@model declaracionPatrimonial.Models.creditoBancario

@{
    ViewData["Title"] = "Editar Crédito Bancario";
}

<div class="container py-5">

    <!-- ENCABEZADO -->
    <div class="bg-white/80 backdrop-blur-md shadow-lg rounded-4 border border-gray-100 p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bold mb-1 text-gradient"
                    style="background: linear-gradient(90deg, #6a11cb, #2575fc); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                    Editar Crédito Bancario
                </h2>
                <p class="text-muted mb-0">Actualice los datos del crédito bancario seleccionado.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-primary rounded-pill fw-semibold shadow-sm">
                <i class="bi bi-arrow-left me-1"></i> Volver
            </a>
        </div>
    </div>

    <!-- FORMULARIO -->
    <div class="bg-white p-5 shadow-lg rounded-4 border-0">
        <div id="errorSummary" class="alert alert-danger d-none rounded-3"></div>

        <form asp-action="Edit" method="post" novalidate autocomplete="off" id="formCreditoBancario" class="needs-validation">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="IDCreditoBancario" />
            <input type="hidden" asp-for="IDUsuario" />

            <!-- Campos ocultos para banco y tipo cuenta -->
            <input type="hidden" asp-for="IDBanco" id="hiddenBanco" />
            <input type="hidden" asp-for="IDtipoCuenta" id="hiddenTipoCuenta" />

            <div class="row g-4">

                <!-- Cuenta Asociada -->
                <div class="col-md-6">
                    <label asp-for="IDCuentaBancaria" class="form-label fw-semibold">Cuenta asociada <span class="text-danger">*</span></label>
                    <select asp-for="IDCuentaBancaria" id="IDCuentaBancaria"
                            class="form-select border-0 shadow-sm rounded-3 focus-ring" required>
                        <option value="">Seleccione una cuenta</option>
                        @foreach (var cuenta in ViewBag.CuentasBancarias)
                        {
                            <option value="@cuenta.IDCuentaBancaria"
                                    data-saldo="@cuenta.Saldo_cuentaBancaria"
                                    data-numero="@cuenta.Numero_cuentaBancaria"
                                    data-banco="@cuenta.IDBanco"
                                    data-tipocuenta="@cuenta.IDtipoCuenta"
                                    selected="@(cuenta.IDCuentaBancaria == Model.IDCuentaBancaria ? "selected" : null)">
                                @cuenta.Numero_cuentaBancaria
                            </option>
                        }
                    </select>

                    @if (ViewData.ModelState["IDCuentaBancaria"]?.Errors.Count > 0)
                    {
                        <span class="text-danger small">Debe seleccionar una cuenta bancaria.</span>
                    }
                </div>

                <!-- Banco -->
                <div class="col-md-6">
                    <label asp-for="IDBanco" class="form-label fw-semibold">Banco</label>
                    <select id="IDBanco"
                            class="form-select border-0 shadow-sm rounded-3 focus-ring"
                            asp-items="@(new SelectList(ViewBag.Bancos, "IDBanco", "Nombre_Banco", Model.IDBanco))"
                            disabled required>
                        <option value="">Seleccione un banco</option>
                    </select>

                    @if (ViewData.ModelState["IDBanco"]?.Errors.Count > 0)
                    {
                        <span class="text-danger small">Debe seleccionar un banco válido.</span>
                    }
                </div>

                <!-- Tipo de Cuenta -->
                <div class="col-md-6">
                    <label asp-for="IDtipoCuenta" class="form-label fw-semibold">Tipo de cuenta</label>
                    <select id="IDtipoCuenta"
                            class="form-select border-0 shadow-sm rounded-3 focus-ring"
                            asp-items="@(new SelectList(ViewBag.TiposCuenta, "IDtipoCuenta", "Nombre_tipoCuenta", Model.IDtipoCuenta))"
                            disabled required>
                        <option value="">Seleccione tipo de cuenta</option>
                    </select>

                    @if (ViewData.ModelState["IDtipoCuenta"]?.Errors.Count > 0)
                    {
                        <span class="text-danger small">Debe asociar un tipo de cuenta válido.</span>
                    }
                </div>

                <!-- Número de cuenta -->
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Número de cuenta</label>
                    <input type="text" id="numeroCuenta"
                           class="form-control border-0 shadow-sm rounded-3"
                           readonly value="@Model.cuentaBancaria?.Numero_cuentaBancaria" />
                </div>

                <!-- Saldo -->
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Saldo actual en cuenta (Q)</label>
                    <input type="text" id="saldoCuenta"
                           class="form-control border-0 shadow-sm rounded-3"
                           readonly value="@Model.cuentaBancaria?.Saldo_cuentaBancaria.ToString("F2")" />
                </div>

                <!-- Cantidad Aprobada -->
                <div class="col-md-6">
                    <label asp-for="Cantidad_AprobadaCredito" class="form-label fw-semibold">Cantidad aprobada (Q) <span class="text-danger">*</span></label>
                    <input asp-for="Cantidad_AprobadaCredito" type="number" step="0.01" min="100"
                        class="form-control border-0 shadow-sm rounded-3"
                        placeholder="Ej. 50000.00" required />


                    @if (ViewData.ModelState["Cantidad_AprobadaCredito"]?.Errors.Count > 0)
                    {
                        <span class="text-danger small">Debe ingresar una cantidad válida (mínimo Q100.00).</span>
                    }
                </div>

                <!-- Motivo -->
                <div class="col-md-12">
                    <label asp-for="Motivo_creditoBancario" class="form-label fw-semibold">Motivo del crédito <span class="text-danger">*</span></label>
                    <input asp-for="Motivo_creditoBancario"
                           class="form-control border-0 shadow-sm rounded-3"
                           placeholder="Ej. Compra de vehículo, vivienda, negocio..."
                           maxlength="200"
                           required />

                    @if (ViewData.ModelState["Motivo_creditoBancario"]?.Errors.Count > 0)
                    {
                        <span class="text-danger small">Debe indicar un motivo válido (mínimo 5 caracteres).</span>
                    }
                </div>
            </div>

            <!-- BOTONES -->
            <div class="text-center mt-5">
                <button type="submit" class="btn btn-gradient px-5 py-2 rounded-pill text-white shadow-sm fw-semibold ripple"
                        style="background: linear-gradient(90deg, #6a11cb, #2575fc);">
                    <i class="bi bi-save me-2"></i>Guardar Cambios
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary px-5 py-2 rounded-pill ms-2 shadow-sm ripple">
                    <i class="bi bi-x-circle me-2"></i>Cancelar
                </a>
            </div>
        </form>
    </div>
</div>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/validacionCredito.js"></script>
    </script>
}


