<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - declaracionPatrimonial</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/declaracionPatrimonial.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    
    @RenderSection("Styles", required: false)
</head>

<body>
    @* Obtener la bandera desde ViewData (true para ocultar sidebar) *@
    @{
        var hideSidebar = (ViewData["HideSidebar"] as bool?) ?? false;
    }

    <div class="container-fluid">
        <div class="row">
            @* Sidebar: solo renderizar si no se pide ocultarla *@
            @if (!hideSidebar)
            {
                <div class="col-auto p-0">
                    <div class="d-flex flex-column p-3 bg-light border-end vh-100" style="width: 250px;">
                        <h4 class="mb-4">Menu</h4>
                        <ul class="nav nav-pills flex-column mb-auto">
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="@Url.Action("Index", "Home")">
                                    <i class="bi bi-house-door-fill me-2"></i> Inicio
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="#" data-bs-toggle="modal" data-bs-target="#modalActivos">
                                    <i class="bi bi-wallet2 me-2"></i> Activos
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="#" data-bs-toggle="modal" data-bs-target="#modalPasivos">
                                    <i class="bi bi-credit-card-2-back me-2"></i> Pasivos
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="#" data-bs-toggle="modal" data-bs-target="#modalPatrimonios">
                                    <i class="bi bi-piggy-bank me-2"></i> Patrimonio
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            }

            <!-- Contenido principal -->
            <div class="col p-4">
                @RenderBody()
            </div>
        </div>
    </div>

    <!-- Modal Activos -->
    <div class="modal fade" id="modalActivos" tabindex="-1" aria-labelledby="modalActivosLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <!-- Header -->
                <div class="modal-header">
                    <h5 class="modal-title" id="modalActivosLabel">Seleccionar tipo de activo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <!-- Body con opciones -->
                <div class="modal-body">
                    <div class="list-group">
                        <a href="@Url.Action("Index", "CuentaBancaria")" class="list-group-item list-group-item-action">
                            <i class="bi bi-bank me-2"></i> Cuentas de Banco
                        </a>
                        <a href="@Url.Action("Index", "Bienes")" class="list-group-item list-group-item-action">
                            <i class="bi bi-house-fill me-2"></i> Bienes Inmuebles y Muebles
                        </a>
                    </div>
                </div>
                <!-- Footer -->
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

     <!-- Modal Pasivos -->
    <div class="modal fade" id="modalPasivos" tabindex="-1" aria-labelledby="modalPasivosLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <!-- Header -->
                <div class="modal-header">
                    <h5 class="modal-title" id="modalPasivosLabel">Seleccionar tipo de pasivo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <!-- Body con opciones -->
                <div class="modal-body">
                    <div class="list-group">
                        <a href="@Url.Action("Index", "creditoBancario")" class="list-group-item list-group-item-action">
                            <i class="bi bi-bank me-2"></i> Créditos Bancarios
                        </a>
                        <a href="@Url.Action("Index", "otroPasivo")" class="list-group-item list-group-item-action">
                            <i class="bi bi-box-seam me-2"></i> Otros Pasivos
                        </a>
                    </div>
                </div>
                <!-- Footer -->
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

     <!-- Modal Patrimonio -->
    <div class="modal fade" id="modalPatrimonios" tabindex="-1" aria-labelledby="modalPatrimoniosLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <!-- Header -->
                <div class="modal-header">
                    <h5 class="modal-title" id="modalPatrimoniosLabel">Seleccionar tipo de Patrimonio</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <!-- Body con opciones -->
                <div class="modal-body">
                    <div class="list-group">
                        <a href="@Url.Action("Index", "Patrimonio")" class="list-group-item list-group-item-action">
                            <i class="bi bi-piggy-bank me-2"></i> Patrimonio
                        </a>
                    </div>
                </div>
                <!-- Footer -->
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
