@model declaracionPatrimonial.Models.otroPasivo

@{
    ViewData["Title"] = "Registrar Otro Pasivo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">

    <!-- ENCABEZADO -->
    <div class="bg-white/80 backdrop-blur-md shadow-lg rounded-4 border border-gray-100 p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bold mb-1 text-gradient"
                    style="background: linear-gradient(90deg, #6a11cb, #2575fc);
                           -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                    Registrar Nuevo Pasivo
                </h2>
                <p class="text-muted mb-0">Complete todos los campos para registrar correctamente el pasivo.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-primary rounded-pill fw-semibold shadow-sm">
                <i class="bi bi-arrow-left me-1"></i> Volver
            </a>
        </div>
    </div>

    <!-- FORMULARIO -->
    <div class="bg-white p-5 shadow-lg rounded-4 border-0">
        <form asp-action="Create" method="post" id="formOtroPasivo" novalidate autocomplete="off">
            @Html.AntiForgeryToken()

            <div class="row g-4">
                <!-- CUENTA ASOCIADA -->
                <div class="col-md-6">
                    <label asp-for="IDCuentaBancaria" class="form-label fw-semibold">Cuenta Bancaria Asociada</label>
                    <select asp-for="IDCuentaBancaria"
                            id="IDCuentaBancaria"
                            class="form-select border-0 shadow-sm rounded-3">
                        <option value="">Seleccione una cuenta</option>
                        @foreach (var cuenta in ViewBag.cuentasBancarias)
                        {
                            <option value="@cuenta.IDCuentaBancaria"
                                    data-saldo="@cuenta.Saldo_cuentaBancaria"
                                    data-numero="@cuenta.Numero_cuentaBancaria">
                                @cuenta.Numero_cuentaBancaria
                            </option>
                        }
                    </select>
                </div>

                <!-- NÚMERO DE CUENTA -->
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Número de cuenta seleccionado</label>
                    <input type="text" id="numeroCuenta" class="form-control border-0 shadow-sm rounded-3" readonly />
                </div>

                <!-- SALDO -->
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Saldo en cuenta (Q)</label>
                    <input type="text" id="saldoCuenta" class="form-control border-0 shadow-sm rounded-3" readonly />
                </div>

                <!-- CANTIDAD -->
                <div class="col-md-6">
                    <label asp-for="Cantidad_aprobadaPasivo" class="form-label fw-semibold">Cantidad aprobada (Q)</label>
                    <input asp-for="Cantidad_aprobadaPasivo"
                           type="number"
                           step="0.01"
                           min="0"
                           class="form-control border-0 shadow-sm rounded-3"
                           placeholder="Ej. 15000.00" />
                </div>

                <!-- MOTIVO -->
                <div class="col-md-12">
                    <label asp-for="Motivo_Pasivo" class="form-label fw-semibold">Motivo del pasivo</label>
                    <input asp-for="Motivo_Pasivo"
                           class="form-control border-0 shadow-sm rounded-3"
                           placeholder="Ej. préstamo personal, consolidación de deuda, etc."
                           maxlength="200" />
                </div>
            </div>

            <!-- ERRORES -->
            <div id="errorSummary" class="alert alert-danger mt-4 d-none rounded-4 shadow-sm">
                <h6 class="fw-bold"><i class="bi bi-exclamation-triangle me-2"></i>Errores encontrados:</h6>
                <ul class="mb-0"></ul>
            </div>

            <!-- BOTONES -->
                <div class="text-center mt-5">
                    <button type="submit"
                            class="btn btn-gradient px-5 py-2 rounded-pill text-white shadow-sm fw-semibold ripple"
                            style="background: linear-gradient(90deg, #6a11cb, #2575fc);">
                        <i class="bi bi-check-circle me-2"></i>Guardar Pasivo
                    </button>
                    <button type="button" id="btnCancelar" class="btn btn-outline-secondary px-5 py-2 rounded-pill ms-2 shadow-sm ripple">
                        <i class="bi bi-x-circle me-2"></i>Cancelar
                    </button>
                </div>

        </form>
    </div>
</div>

<!-- MODAL CONFIRMACIÓN -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 text-white"
                 style="background: linear-gradient(90deg, #6a11cb, #2575fc);">
                <h5 class="modal-title fw-semibold"><i class="bi bi-check2-circle me-2"></i>Confirmación</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center py-4">
                <p class="mb-3 fs-5"> La cuenta bancaria se ha registrado exitosamente.</p>
                <button class="btn btn-gradient text-white px-4 rounded-pill" data-bs-dismiss="modal"
                        style="background: linear-gradient(90deg, #6a11cb, #2575fc);">
                    Aceptar
                </button>
            </div>
        </div>
    </div>
</div>
<!-- Modal de cancelación -->
<div class="modal fade" id="cancelModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 text-white"
                 style="background: #6c757d;">
                <h5 class="modal-title fw-semibold"><i class="bi bi-exclamation-triangle me-2"></i>Cancelar Registro</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center py-4">
                <p class="mb-3 fs-5">¿Está seguro que desea cancelar el registro del crédito?</p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">Sí, cancelar</a>
                    <button class="btn btn-gradient text-white px-4 rounded-pill" data-bs-dismiss="modal"
                            style="background: linear-gradient(90deg, #6a11cb, #2575fc);">No</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", function () {
    const form = document.getElementById("formOtroPasivo");
    if (!form) return;

    const errorSummary = document.getElementById("errorSummary");
    const confirmModalEl = document.getElementById("confirmModal");
    const btnCancelar = document.getElementById("btnCancelar");

    form.setAttribute("novalidate", true);
    form.querySelectorAll("input, select, textarea").forEach(campo => {
        campo.addEventListener("invalid", e => e.preventDefault());
        campo.removeAttribute("required");
    });

    const campos = {
        IDCuentaBancaria: form.querySelector("#IDCuentaBancaria"),
        Cantidad_aprobadaPasivo: form.querySelector("[name='Cantidad_aprobadaPasivo']"),
        Motivo_Pasivo: form.querySelector("[name='Motivo_Pasivo']")
    };

    const inputSaldo = document.getElementById("saldoCuenta");
    const inputNumero = document.getElementById("numeroCuenta");

    campos.IDCuentaBancaria.addEventListener("change", function () {
        const selected = this.options[this.selectedIndex];
        inputSaldo.value = selected.dataset.saldo || "";
        inputNumero.value = selected.dataset.numero || "";
        validarCuenta();
    });

    // ===============================
    // FUNCIONES AUXILIARES
    // ===============================
    function mostrarError(input, mensaje) {
        input.classList.add("is-invalid");
        input.classList.remove("is-valid");
        let feedback = input.parentElement.querySelector(".invalid-feedback");
        if (!feedback) {
            feedback = document.createElement("div");
            feedback.classList.add("invalid-feedback", "d-block", "small");
            input.parentElement.appendChild(feedback);
        }
        feedback.textContent = mensaje;
    }

    function limpiarError(input) {
        input.classList.remove("is-invalid");
        input.classList.add("is-valid");
        const fb = input.parentElement.querySelector(".invalid-feedback");
        if (fb) fb.textContent = "";
    }

    function agregarErrorResumen(mensaje) {
        const li = document.createElement("li");
        li.textContent = mensaje;
        errorSummary.querySelector("ul").appendChild(li);
    }

    function limpiarResumen() {
        errorSummary.classList.add("d-none");
        errorSummary.querySelector("ul").innerHTML = "";
    }

    // ===============================
    // VALIDACIÓN EN TIEMPO REAL
    // ===============================
    const regexTexto = /^[a-zA-Z0-9ÁÉÍÓÚáéíóúñÑ\s.,-]+$/;

    function validarCuenta() {
        if (!campos.IDCuentaBancaria.value) {
            mostrarError(campos.IDCuentaBancaria, "Debe seleccionar una cuenta bancaria.");
        } else {
            limpiarError(campos.IDCuentaBancaria);
        }
    }

    function validarCantidad() {
        const valor = parseFloat(campos.Cantidad_aprobadaPasivo.value);
        if (isNaN(valor) || valor <= 0) {
            mostrarError(campos.Cantidad_aprobadaPasivo, "Ingrese una cantidad válida mayor a 0.");
        } else if (valor > 10000000) {
            mostrarError(campos.Cantidad_aprobadaPasivo, "La cantidad no puede superar Q10,000,000.");
        } else if (!/^\d+(\.\d{1,2})?$/.test(campos.Cantidad_aprobadaPasivo.value)) {
            mostrarError(campos.Cantidad_aprobadaPasivo, "La cantidad puede tener máximo 2 decimales.");
        } else {
            limpiarError(campos.Cantidad_aprobadaPasivo);
        }
    }

    function validarMotivo() {
        const motivo = campos.Motivo_Pasivo.value.trim();
        if (motivo.length < 5) {
            mostrarError(campos.Motivo_Pasivo, "El motivo debe tener al menos 5 caracteres.");
        } else if (motivo.length > 300) {
            mostrarError(campos.Motivo_Pasivo, "El motivo no puede superar 300 caracteres.");
        } else if (!regexTexto.test(motivo)) {
            mostrarError(campos.Motivo_Pasivo, "El motivo contiene caracteres no permitidos.");
        } else {
            limpiarError(campos.Motivo_Pasivo);
        }
    }

    campos.IDCuentaBancaria.addEventListener("input", validarCuenta);
    campos.Cantidad_aprobadaPasivo.addEventListener("input", validarCantidad);
    campos.Motivo_Pasivo.addEventListener("input", validarMotivo);

    // ===============================
    // CANCELAR CON MODAL
    // ===============================
    btnCancelar.addEventListener("click", function () {
        const cancelModal = new bootstrap.Modal(document.getElementById("cancelModal"));
        cancelModal.show();
    });

    // ===============================
    // VALIDACIÓN FINAL AL ENVIAR
    // ===============================
    form.addEventListener("submit", function (e) {
        e.preventDefault();
        limpiarResumen();

        validarCuenta();
        validarCantidad();
        validarMotivo();

        let hayErrores = campos.IDCuentaBancaria.classList.contains("is-invalid") ||
                         campos.Cantidad_aprobadaPasivo.classList.contains("is-invalid") ||
                         campos.Motivo_Pasivo.classList.contains("is-invalid");

        if (hayErrores) {
            if (!campos.IDCuentaBancaria.value) agregarErrorResumen("Debe seleccionar una cuenta bancaria.");
            if (!campos.Cantidad_aprobadaPasivo.value || parseFloat(campos.Cantidad_aprobadaPasivo.value) <= 0) 
                agregarErrorResumen("Ingrese una cantidad válida mayor a 0.");
            if (campos.Motivo_Pasivo.value.trim().length < 5) 
                agregarErrorResumen("El motivo debe tener al menos 5 caracteres.");
            if (campos.Motivo_Pasivo.value.length > 300)
                agregarErrorResumen("El motivo no puede superar 300 caracteres.");
            if (!regexTexto.test(campos.Motivo_Pasivo.value.trim()))
                agregarErrorResumen("El motivo contiene caracteres no permitidos.");

            errorSummary.classList.remove("d-none");
            errorSummary.scrollIntoView({ behavior: "smooth", block: "start" });
            return;
        }

        const confirmModal = new bootstrap.Modal(confirmModalEl);
        confirmModal.show();
        confirmModalEl.addEventListener('hidden.bs.modal', function () {
            form.submit();
        }, { once: true });
    });
});
</script>
}

}
