@model declaracionPatrimonial.Models.otroPasivo

@{
    ViewData["Title"] = "Editar Otro Pasivo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="card border-0 shadow-xl rounded-4 overflow-hidden">

        <!-- ENCABEZADO -->
        <div class="card-header text-white py-4 px-4"
             style="background: linear-gradient(90deg, #6a11cb, #2575fc);">
            <div class="d-flex justify-content-between align-items-center">
                <h3 class="mb-0 fw-semibold d-flex align-items-center">
                    <i class="bi bi-wallet2 me-2 fs-4"></i>
                    Editar Otro Pasivo
                </h3>
                <a asp-action="Index" class="btn btn-light btn-sm fw-semibold shadow-sm px-3">
                    <i class="bi bi-arrow-left me-1"></i> Volver
                </a>
            </div>
        </div>

        <!-- FORMULARIO -->
        <div class="card-body bg-light p-4">
            <form asp-action="Edit" method="post" id="formEditarPasivo" class="needs-validation" novalidate autocomplete="off">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="IDPasivo" />
                <input type="hidden" asp-for="IDUsuario" />

                <div class="row g-4">

                    <!-- CUENTA ASOCIADA -->
                    <div class="col-md-6">
                        <label asp-for="IDCuentaBancaria" class="form-label fw-semibold">Número de cuenta o entidad</label>
                        <select asp-for="IDCuentaBancaria"
                                id="IDCuentaBancaria"
                                class="form-select rounded-3 shadow-sm">
                            <option value="">Seleccione una cuenta</option>
                            @foreach (var cuenta in ViewBag.CuentasBancarias)
                            {
                                <option value="@cuenta.IDCuentaBancaria"
                                        data-numero="@cuenta.Numero_cuentaBancaria"
                                        data-saldo="@cuenta.Saldo_cuentaBancaria"
                                        selected="@(cuenta.IDCuentaBancaria == Model.IDCuentaBancaria)">
                                    @cuenta.Numero_cuentaBancaria
                                </option>
                            }
                        </select>
                        <span asp-validation-for="IDCuentaBancaria" class="text-danger small"></span>
                    </div>

                    <!-- NÚMERO DE CUENTA (solo lectura) -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Número de cuenta seleccionado</label>
                        <input type="text" id="numeroCuenta"
                               class="form-control rounded-3 shadow-sm"
                               readonly
                               value="@Model.cuentaBancaria?.Numero_cuentaBancaria" />
                    </div>

                    <!-- SALDO EN CUENTA (solo lectura) -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Saldo en cuenta (Q)</label>
                        <input type="text" id="saldoCuenta"
                               class="form-control rounded-3 shadow-sm"
                               readonly
                               value="@(Model.cuentaBancaria?.Saldo_cuentaBancaria.ToString("F2"))" />
                    </div>

                    <!-- CANTIDAD APROBADA -->
                    <div class="col-md-6">
                        <label asp-for="Cantidad_aprobadaPasivo" class="form-label fw-semibold">Cantidad aprobada (Q)</label>
                        <input asp-for="Cantidad_aprobadaPasivo"
                               type="number" step="0.01" min="0"
                               class="form-control rounded-3 shadow-sm"
                               placeholder="Ej. 20000.00" />
                        <span asp-validation-for="Cantidad_aprobadaPasivo" class="text-danger small"></span>
                    </div>

                    <!-- MOTIVO DEL PASIVO -->
                    <div class="col-md-12">
                        <label asp-for="Motivo_Pasivo" class="form-label fw-semibold">Motivo del pasivo</label>
                        <input asp-for="Motivo_Pasivo"
                               class="form-control rounded-3 shadow-sm"
                               placeholder="Ej. préstamo personal, consolidación de deuda..."
                               maxlength="200" />
                        <span asp-validation-for="Motivo_Pasivo" class="text-danger small"></span>
                    </div>
                </div>

                <!-- BOTONES -->
                <div class="text-center mt-5">
                    <button type="submit"
                            class="btn px-5 py-2 rounded-pill text-white shadow-sm fw-semibold"
                            style="background: linear-gradient(90deg, #6a11cb, #2575fc); transition: all 0.3s;">
                        <i class="bi bi-save me-2"></i>Guardar Cambios
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-5 py-2 rounded-pill ms-2 fw-semibold">
                        <i class="bi bi-x-circle me-1"></i>Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/validacionPasivo.js"></script>
}
